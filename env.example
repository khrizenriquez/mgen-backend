# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/donations_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=donations_db
DB_HOST=localhost
DB_PORT=5432

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SQL_ECHO=false

# RabbitMQ Configuration
RABBITMQ_URL=amqp://username:password@localhost:5672/
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_secure_password

# Application Configuration
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-here-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-required-no-default
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SERVICE_NAME=donations-api
VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Default User Password (only for development)
DEFAULT_USER_PASSWORD=seminario123

# Default Organization Configuration
DEFAULT_ORGANIZATION_NAME=Más Generosidad Guatemala
DEFAULT_ORGANIZATION_DESCRIPTION=Organización principal de donaciones en Guatemala
DEFAULT_ORGANIZATION_EMAIL=contacto@masgenerosidad.org

# Default Test User Emails (only for development)
DEFAULT_ADMIN_EMAIL=adminseminario@test.com
DEFAULT_DONOR_EMAIL=donorseminario@test.com
DEFAULT_USER_EMAIL=userseminario@test.com

# Email Configuration (SendGrid - for password reset and verification)
# IMPORTANT: Never commit real credentials to Git!
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@donacionesgt.org
FROM_NAME=Sistema de Donaciones

# Frontend & API URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Logging Configuration
LOG_LEVEL=INFO
LOG_LEVEL_NUM=20

# Monitoring Configuration
GRAFANA_ADMIN_USER=your_grafana_admin_user
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# Apitally Monitoring (for production monitoring)
APITALLY_CLIENT_ID=your-apitally-client-id-here
APITALLY_ENV=prod  # or "dev" for development

# Prometheus Basic Authentication (Optional - uncomment to enable)
# PROMETHEUS_USERNAME=your_prometheus_user
# PROMETHEUS_PASSWORD=your_secure_prometheus_password

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://masgenerosidad.org,https://www.masgenerosidad.org,https://app.masgenerosidad.org
CSRF_SECRET_KEY=your-csrf-secret-key

# Local tools (only used with Docker profile "dev")
PGADMIN_DEFAULT_EMAIL=admin@duku.dev
PGADMIN_DEFAULT_PASSWORD=admin

# PayU Payment Gateway Configuration
# PayU Test Credentials (from https://developers.payulatam.com/latam/es/docs/getting-started/test-your-solution.html)
PAYU_API_KEY=4Vj8eK4rloUd272L48hsrarnUA
PAYU_API_LOGIN=pRRXKOl8ikMmt9u
PAYU_MERCHANT_ID=508029
PAYU_PUBLIC_KEY=PKaC6H4cEDJD919n705L544kSU
PAYU_ACCOUNT_ID=512322  # Default for most countries, override for specific countries

# PayU Configuration by Country (Account IDs)
PAYU_ACCOUNT_ID_AR=512322  # Argentina
PAYU_ACCOUNT_ID_BR=512327  # Brazil
PAYU_ACCOUNT_ID_CL=512325  # Chile
PAYU_ACCOUNT_ID_CO=512321  # Colombia
PAYU_ACCOUNT_ID_MX=512324  # Mexico
PAYU_ACCOUNT_ID_PA=512326  # Panama
PAYU_ACCOUNT_ID_PE=512323  # Peru
PAYU_ACCOUNT_ID_GT=512322  # Guatemala (using AR as default)

# PayU Environment Settings
PAYU_TEST_MODE=true
PAYU_COUNTRY_CODE=GT  # GT for Guatemala
PAYU_CURRENCY=GTQ     # Guatemalan Quetzal

# PayU API URLs
PAYU_BASE_URL=https://sandbox.api.payulatam.com  # Test environment
PAYU_PAYMENTS_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu  # Payment gateway

# PayU Webhook Configuration
PAYU_WEBHOOK_SECRET=your-webhook-secret-here  # For webhook signature validation
PAYU_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/payu/confirmation

# PayU Timeouts and Retry Configuration
PAYU_REQUEST_TIMEOUT=30
PAYU_MAX_RETRIES=3
PAYU_RETRY_DELAY=5